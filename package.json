{
  "name": "lumafold",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:ext",
    "dev:ext": "npm run dev --workspace=@lumafold/extension",
    "dev:landing": "npm run dev --workspace=@lumafold/landing",
    "build:ext": "npm run build --workspace=@lumafold/extension",
    "build:landing": "npm run build --workspace=@lumafold/landing",
    "build": "npm run build:ext && npm run build:landing",
    "preview:ext": "npm run preview --workspace=@lumafold/extension",
    "preview:landing": "npm run preview --workspace=@lumafold/landing",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "npm run type-check --workspaces",
    "test": "npm run test --workspace=@lumafold/extension",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run type-check",
    "update-skills": "node scripts/update-skills.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.63.0"
  }
}
