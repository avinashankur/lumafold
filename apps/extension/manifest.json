{
  "manifest_version": 3,
  "name": "Lumafold",
  "version": "1.0.0",
  "description": "A minimal, powerful notes app with folders, panels, and rich text editing.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lumafold@extension",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage", "tabs", "system.display"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+X" },
      "description": "Open Lumafold toolbar popup"
    },
    "open-fullscreen": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Open Lumafold in full tab"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
